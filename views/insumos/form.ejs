<%- include('../partials/header') %>

<a class="back-link" href="/insumos">← Voltar para insumos</a>
<section class="page-heading form-heading">
  <div>
    <h1><%= title %></h1>
    <p><%= id ? 'Atualize as informações do produto.' : 'Informe os dados do produto para adicioná-lo ao catálogo.' %></p>
  </div>
</section>

<div class="form-card">
  <%- include('../partials/form-errors') %>

  <form action="<%= id ? '/insumos/' + id + '/editar' : '/insumos' %>" method="post">
    <p class="required-note">Os campos com * são obrigatórios.</p>

    <div class="mb-4">
      <label class="form-label" for="nome">Nome do insumo *</label>
      <input class="form-control <%= campos.nome ? 'is-invalid' : '' %>"
        type="text"
        id="nome"
        name="nome"
        value="<%= valores.nome %>"
        maxlength="120"
        required placeholder="Ex.: Arroz branco"
        aria-invalid="<%= Boolean(campos.nome) %>"
        aria-describedby="nome-help">
      <div id="nome-help" class="<%= campos.nome ? 'invalid-feedback' : 'form-text' %>"><%= campos.nome || 'Use um nome que permita identificar o produto.' %></div>
    </div>

    <div class="mb-4">
      <label class="form-label" for="unidadeMedida">Unidade de medida *</label>
      <select class="form-select <%= campos.unidadeMedida ? 'is-invalid' : '' %>"
        id="unidadeMedida"
        name="unidadeMedida"
        required aria-invalid="<%= Boolean(campos.unidadeMedida) %>"
        aria-describedby="unidade-help">
        <option value="">Selecione uma unidade</option>
        <% const rotulos = { kg: 'Quilograma (kg)', g: 'Grama (g)', L: 'Litro (L)', mL: 'Mililitro (mL)', un: 'Unidade (un)' }; %>
        <% for (const unidade of unidadesMedida) { %>
          <option value="<%= unidade %>" <%= valores.unidadeMedida === unidade ? 'selected' : '' %>><%= rotulos[unidade] %></option>
        <% } %>
      </select>
      <div id="unidade-help" class="<%= campos.unidadeMedida ? 'invalid-feedback' : 'form-text' %>"><%= campos.unidadeMedida || 'Unidade usada nas movimentações. Após criar vínculos, ela fica protegida para preservar o histórico.' %></div>
    </div>

    <div>
      <label class="form-label" for="descricao">Descrição <span class="optional-label">opcional</span></label>
      <textarea class="form-control <%= campos.descricao ? 'is-invalid' : '' %>"
        id="descricao"
        name="descricao"
        rows="3"
        maxlength="500"
        placeholder="Ex.: Tipo 1, pacote de 5 kg"
        aria-invalid="<%= Boolean(campos.descricao) %>"
        aria-describedby="descricao-help"><%= valores.descricao %></textarea>
      <div id="descricao-help" class="<%= campos.descricao ? 'invalid-feedback' : 'form-text' %>"><%= campos.descricao || 'Até 500 caracteres.' %></div>
    </div>

    <div class="form-actions">
      <a class="btn btn-light" href="/insumos">Cancelar</a>
      <button class="btn btn-primary" type="submit"><%= id ? 'Salvar alterações' : 'Cadastrar insumo' %></button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
